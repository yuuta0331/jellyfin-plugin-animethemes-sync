# Normalize all text files to LF in the repository (matches .editorconfig).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be normalized.
*.jpeg binary
*.jpg binary
*.png binary
*.gif binary
*.ico binary
*.webp binary
*.dll binary
*.pdb binary
*.zip binary
